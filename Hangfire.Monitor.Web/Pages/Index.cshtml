@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<section class="page-header">
    <h1>Hangfire Monitoring</h1>
    <p class="page-subtitle">Monitor your Hangfire applications from a single place.</p>
</section>

<section class="feature-card">
    <h2>Failed Jobs</h2>
    <p>Monitor failed jobs across all configured Hangfire applications.</p>
    <a class="feature-card-link" asp-page="/Jobs/Failed">View failed jobs →</a>
</section>

<section class="feature-card">
    <h2>Storage Health</h2>
    <p>Monitor Hangfire SQL Server storage health across configured applications.</p>
    <a class="feature-card-link" asp-page="/StorageHealth/Index">View storage health →</a>
</section>
