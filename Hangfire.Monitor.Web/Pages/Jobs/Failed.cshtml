@page "/jobs/failed"
@model Hangfire.Monitor.Web.Pages.Jobs.FailedModel
@{
    ViewData["Title"] = "Failed Jobs";
}

<section class="page-header">
    <p class="page-breadcrumb">
        <a asp-page="/Index">Home</a>
        <span aria-hidden="true">/</span>
        <span>Failed Jobs</span>
    </p>
    <h1>Failed Jobs</h1>
    <p class="page-subtitle">Monitor failed jobs across all configured Hangfire applications.</p>
</section>

@if (Model.Results.Count == 0)
{
    <p class="empty-message">No applications configured.</p>
}
else
{
    <div class="table-panel">
        <table class="status-table">
            <thead>
                <tr>
                    <th data-sort-type="text" aria-sort="none">Application</th>
                    <th data-sort-type="text" aria-sort="none">Status</th>
                    <th data-sort-type="number" aria-sort="none" data-default-sort="desc">Failed jobs</th>
                    <th data-sort-type="date" aria-sort="none">Last failure</th>
                    <th data-sort-type="number" aria-sort="none">Servers</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var result in Model.Results)
            {
                var statusClass = $"status-badge status-{result.Status.ToString().ToLowerInvariant()}";
                var lastFailedAtSortValue = LastFailedAtDisplay.FormatSortValue(result.LastFailedAt);
                var lastFailedAtDisplay = LastFailedAtDisplay.FormatDisplay(result.LastFailedAt);
                <tr class="@(result.ServerCount == 0 ? "status-row-no-servers" : null)">
                    <td>@result.ApplicationName</td>
                    <td><span class="@statusClass">@result.Status</span></td>
                    <td data-sort-value="@result.FailedCount.ToString(System.Globalization.CultureInfo.InvariantCulture)">@result.FailedCount</td>
                    <td data-sort-value="@lastFailedAtSortValue">@lastFailedAtDisplay</td>
                    <td data-sort-value="@result.ServerCount.ToString(System.Globalization.CultureInfo.InvariantCulture)">@result.ServerCount</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

@section Scripts {
    <script src="~/js/status-table-sort.js" asp-append-version="true"></script>
    <script>
        (function () {
            var table = document.querySelector(".status-table");
            if (!table) {
                return;
            }

            var header = table.querySelector('th[data-default-sort="desc"]');
            if (!header) {
                return;
            }

            header.click();
            header.click();
        })();
    </script>
}
