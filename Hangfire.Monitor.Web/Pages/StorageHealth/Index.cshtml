@page "/storage-health"
@model Hangfire.Monitor.Web.Pages.StorageHealth.IndexModel
@{
    ViewData["Title"] = "Storage Health";
    var numberCulture = NumberCulturePreference.ResolveCulture(ViewContext.HttpContext.Request);
}

<section class="page-header">
    <p class="page-breadcrumb">
        <a asp-page="/Index">Home</a>
        <span aria-hidden="true">/</span>
        <span>Storage Health</span>
    </p>
    <h1>Storage Health</h1>
    <p class="page-subtitle">Monitor Hangfire SQL Server storage health across configured applications.</p>
</section>

@if (Model.Results.Count == 0)
{
    <p class="empty-message">No applications configured.</p>
}
else
{
    <div class="table-panel">
        <table class="status-table">
            <thead>
                <tr>
                    <th data-sort-type="text" aria-sort="none">Application</th>
                    <th data-sort-type="text" aria-sort="none">Version</th>
                    <th data-sort-type="number" aria-sort="none" data-default-sort="desc">Health</th>
                    <th data-sort-type="number" aria-sort="none">Schema</th>
                    <th data-sort-type="number" aria-sort="none">Data Files</th>
                    <th data-sort-type="number" aria-sort="none">Data Files %</th>
                    <th data-sort-type="number" aria-sort="none">Log</th>
                    <th data-sort-type="number" aria-sort="none">Log %</th>
                    <th data-sort-type="text" aria-sort="none">Log Reuse</th>
                    <th data-sort-type="number" aria-sort="none">Transactions</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var result in Model.Results)
            {
                var healthSortValue = StorageHealthDisplay.FormatHealthSortValue(result.Status);
                var versionSortValue = ApplicationDisplay.FormatVersionSortValue(result.Version);
                var versionDisplay = ApplicationDisplay.FormatVersion(result.Version);
                var versionBadgeClass = ApplicationDisplay.FormatVersionBadgeCssClass(
                    result.Version,
                    Model.LatestHangfireVersion);
                var schemaSortValue = result.Schema.ActualVersion?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? string.Empty;
                var dataFilesUsedSortValue = result.DataFiles.UsedPercent is null
                    ? string.Empty
                    : result.DataFiles.UsedMB.ToString(System.Globalization.CultureInfo.InvariantCulture);
                var dataFilesPercentSortValue = result.DataFiles.UsedPercent?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? string.Empty;
                var logUsedSortValue = result.LogSpace?.UsedLogMB.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? string.Empty;
                var logPercentSortValue = result.LogSpace?.UsedPercent.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? string.Empty;
                var transactionsSortValue = result.ActiveTransactions?.Count.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? string.Empty;
                <tr class="@StorageHealthDisplay.FormatRowCssClass(result.ServerCount)">
                    <td>
                        <a asp-page="./Details" asp-route-applicationName="@result.ApplicationName">@result.ApplicationName</a>
                    </td>
                    <td data-sort-value="@versionSortValue"><span class="@versionBadgeClass">@versionDisplay</span></td>
                    <td data-sort-value="@healthSortValue">
                        <span class="@StorageHealthDisplay.FormatHealthBadgeCssClass(result.Status)">@StorageHealthDisplay.FormatHealth(result.Status)</span>
                    </td>
                    <td data-sort-value="@schemaSortValue">
                        <span class="@StorageHealthDisplay.FormatSchemaBadgeCssClass(result.Schema)">@StorageHealthDisplay.FormatSchema(result.Schema)</span>
                    </td>
                    <td data-sort-value="@dataFilesUsedSortValue">@StorageHealthDisplay.FormatDataFileUsed(result.DataFiles, numberCulture)</td>
                    <td data-sort-value="@dataFilesPercentSortValue">@StorageHealthDisplay.FormatDataFileSpace(result.DataFiles, numberCulture)</td>
                    <td data-sort-value="@logUsedSortValue">@StorageHealthDisplay.FormatLogUsed(result.LogSpace, numberCulture)</td>
                    <td data-sort-value="@logPercentSortValue">@StorageHealthDisplay.FormatLogSpace(result.LogSpace, numberCulture)</td>
                    <td>@StorageHealthDisplay.FormatLogReuse(result.LogReuseWait)</td>
                    <td data-sort-value="@transactionsSortValue">@StorageHealthDisplay.FormatTransactions(result.ActiveTransactions)</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

@section Scripts {
    <script src="~/js/status-table-sort.js" asp-append-version="true"></script>
    <script>
        (function () {
            var table = document.querySelector(".status-table");
            if (!table) {
                return;
            }

            var header = table.querySelector('th[data-default-sort="desc"]');
            if (!header) {
                return;
            }

            header.click();
            header.click();
        })();
    </script>
}
