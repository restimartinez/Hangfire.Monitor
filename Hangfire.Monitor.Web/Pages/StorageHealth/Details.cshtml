@page "/storage-health/{applicationName}"
@model Hangfire.Monitor.Web.Pages.StorageHealth.DetailsModel
@{
    ViewData["Title"] = Model.Details is null
        ? "Storage Health"
        : $"Storage Health / {Model.Details.ApplicationName}";
    var details = Model.Details!;
}

<section class="page-header">
    <p class="page-breadcrumb">
        <a asp-page="/Index">Home</a>
        <span aria-hidden="true">/</span>
        <a asp-page="./Index">Storage Health</a>
        <span aria-hidden="true">/</span>
        <span>@details.ApplicationName</span>
    </p>
    <h1>Storage Health / @details.ApplicationName</h1>
    <p class="page-subtitle">Capacity health, diagnosis, and operator guidance for this Hangfire storage database.</p>
</section>

<section class="storage-health-detail">
    <h2>Health</h2>
    <p>
        <span class="@StorageHealthDisplay.FormatHealthBadgeCssClass(details.Status)">@StorageHealthDisplay.FormatHealth(details.Status)</span>
    </p>
</section>

<section class="storage-health-detail">
    <h2>Diagnosis</h2>
    <p>@details.Diagnosis</p>
</section>

@if (details.IsUnavailable)
{
    <p class="empty-message">Storage metrics below are unavailable because the application could not be queried.</p>
}
else
{
    <section class="storage-health-detail @(StorageHealthDisplay.FormatRowCssClass(details.ServerCount))">
        <h2>Hangfire Servers</h2>
        <dl class="metric-list">
            <div>
                <dt>Active servers</dt>
                <dd>@details.ServerCount</dd>
            </div>
        </dl>
    </section>

    <section class="storage-health-detail storage-health-detail-wide">
        <h2>Data Files</h2>
        @if (details.DataFileHeadroom is null || details.DataFileHeadroom.Count == 0)
        {
            <p class="empty-message">Data file headroom metrics are unavailable.</p>
            <dl class="metric-list">
                <div>
                    <dt>Allocated (database)</dt>
                    <dd>@StorageHealthDisplay.FormatMegabytes(details.DataFiles.AllocatedMB)</dd>
                </div>
                <div>
                    <dt>Used (database)</dt>
                    <dd>@StorageHealthDisplay.FormatMegabytes(details.DataFiles.UsedMB)</dd>
                </div>
                <div>
                    <dt>Free (database)</dt>
                    <dd>@StorageHealthDisplay.FormatMegabytes(details.DataFiles.FreeMB)</dd>
                </div>
                <div>
                    <dt>Used %</dt>
                    <dd>@StorageHealthDisplay.FormatUsedPercent(details.DataFiles.UsedPercent)</dd>
                </div>
            </dl>
        }
        else
        {
            <div class="table-panel">
                <table class="status-table metrics-table">
                    <thead>
                        <tr>
                            <th>File</th>
                            <th>Current size</th>
                            <th>Used</th>
                            <th>Free</th>
                            <th>Used %</th>
                            <th>Max size</th>
                            <th>Growth</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var file in details.DataFileHeadroom)
                    {
                        <tr>
                            <td>@file.FileName</td>
                            <td>@StorageHealthDisplay.FormatMegabytes(file.CurrentSizeMB)</td>
                            <td>@StorageHealthDisplay.FormatMegabytes(file.UsedMB)</td>
                            <td>@StorageHealthDisplay.FormatMegabytes(file.FreeMB)</td>
                            <td>@StorageHealthDisplay.FormatUsedPercent(file.UsedPercent)</td>
                            <td>@StorageHealthDisplay.FormatMaxSize(file)</td>
                            <td>@StorageHealthDisplay.FormatGrowth(file)</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="storage-health-detail storage-health-detail-wide">
        <h2>Volumes</h2>
        @if (details.DataFileHeadroom is null || details.DataFileHeadroom.Count == 0)
        {
            <p class="empty-message">Volume statistics are unavailable.</p>
        }
        else
        {
            var volumes = details.DataFileHeadroom
                .GroupBy(f => f.VolumeMountPoint ?? string.Empty)
                .Select(g => g.First())
                .ToList();
            var anyVolume = volumes.Any(v => v.VolumeTotalGB is not null || !string.IsNullOrEmpty(v.VolumeMountPoint));
            if (!anyVolume)
            {
                <p class="empty-message">Volume statistics are not available (missing permissions or unsupported host). This is informational — not a capacity failure by itself.</p>
            }
            else
            {
                <div class="table-panel">
                    <table class="status-table metrics-table">
                        <thead>
                            <tr>
                                <th>Volume</th>
                                <th>Total</th>
                                <th>Free</th>
                                <th>Free %</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var volume in volumes)
                        {
                            <tr>
                                <td>@(string.IsNullOrEmpty(volume.VolumeMountPoint) ? "-" : volume.VolumeMountPoint)</td>
                                <td>@StorageHealthDisplay.FormatGigabytes(volume.VolumeTotalGB)</td>
                                <td>@StorageHealthDisplay.FormatGigabytes(volume.VolumeFreeGB)</td>
                                <td>@StorageHealthDisplay.FormatUsedPercent(volume.VolumeFreePercent)</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        }
    </section>

    <section class="storage-health-detail">
        <h2>Transaction Log</h2>
        @if (details.Log is null)
        {
            <p class="empty-message">Transaction log metrics are unavailable.</p>
        }
        else
        {
            <dl class="metric-list">
                <div>
                    <dt>Total</dt>
                    <dd>@StorageHealthDisplay.FormatMegabytes(details.Log.TotalLogMB)</dd>
                </div>
                <div>
                    <dt>Used</dt>
                    <dd>@StorageHealthDisplay.FormatMegabytes(details.Log.UsedLogMB)</dd>
                </div>
                <div>
                    <dt>Free</dt>
                    <dd>@StorageHealthDisplay.FormatMegabytes(details.Log.FreeLogMB)</dd>
                </div>
                <div>
                    <dt>Used</dt>
                    <dd>@StorageHealthDisplay.FormatUsedPercent(details.Log.UsedPercent)</dd>
                </div>
            </dl>
        }
    </section>

    <section class="storage-health-detail">
        <h2>Log Reuse</h2>
        @if (details.LogReuse is null)
        {
            <p class="empty-message">Log reuse metrics are unavailable.</p>
        }
        else
        {
            <dl class="metric-list">
                <div>
                    <dt>Reuse wait</dt>
                    <dd>@details.LogReuse.Wait</dd>
                </div>
                <div>
                    <dt>Reuse wait description</dt>
                    <dd>@details.LogReuse.WaitDescription</dd>
                </div>
                <div>
                    <dt>Recovery model</dt>
                    <dd>@details.LogReuse.RecoveryModel</dd>
                </div>
            </dl>
        }
    </section>

    <section class="storage-health-detail">
        <h2>Active Transactions</h2>
        @if (details.ActiveTransactions is null)
        {
            <p class="empty-message">Active transaction metrics are unavailable.</p>
        }
        else
        {
            var tx = StorageHealthDisplay.FormatActiveTransactionDetails(details.ActiveTransactions);
            <dl class="metric-list">
                <div>
                    <dt>Active transactions</dt>
                    <dd>@tx.Count</dd>
                </div>
                <div>
                    <dt>Oldest begin time</dt>
                    <dd>@tx.OldestBeginTime</dd>
                </div>
                <div>
                    <dt>Oldest duration</dt>
                    <dd>@tx.OldestDuration</dd>
                </div>
            </dl>
        }
    </section>
}

@if (details.HasResolution && details.Resolution is not null)
{
    var guide = details.Resolution;
    <section class="storage-health-detail storage-health-detail-wide resolution-guide">
        <h2>How to resolve</h2>
        <p class="resolution-warning">@guide.ProductionWarning</p>

        <h3>1. What is happening</h3>
        <p>@guide.WhatIsHappening</p>

        <h3>2. What to check</h3>
        <p>@guide.WhatToCheck</p>

        <h3>3. Recommended action</h3>
        <p>@guide.RecommendedAction</p>

        <h3>4. Diagnostic queries</h3>
        <p>Read-only. Run in an authorized SQL client — Hangfire Monitor does not execute these.</p>
        <pre class="sql-block"><code>@guide.DiagnosticQueriesSql</code></pre>

        <h3>5. Corrective queries</h3>
        <p>These modify database configuration. Copy into SSMS or another authorized tool only. Hangfire Monitor never runs them.</p>
        <pre class="sql-block"><code>@guide.CorrectiveQueriesSql</code></pre>

        <h3>6. Required permissions</h3>
        <p>@guide.RequiredPermissions</p>
    </section>
}
